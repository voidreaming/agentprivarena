# Upstream PrivacyLens artifacts, kept locally for provenance but not vendored.
# The judge prompts in privacylens_live/base/evaluator.py cite line numbers in
# evaluate_final_action.py, so keep the file around to check those citations.
/evaluate_final_action.py
/get_final_action.py
/final_format_unified.json

# The paper is an independently-managed Overleaf repo with its own remote
# (git.overleaf.com). Nesting it here as a gitlink would make the parent repo
# track a commit SHA nobody updates; leave it out entirely.
/paper/

# Output of the example scripts ("write 3 facts about the project into FACTS.txt")
/FACTS.txt

# Private research work and human annotations (preserved locally).
/human_eval/
/human_eval_*/
/rebuttal_*.md
/.aged_tmp_tmp
/private/

