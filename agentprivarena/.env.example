# Copy to agentprivarena/.env and supply your own configuration.
# Never commit .env or a file containing real credentials.
# Process environment variables override values in this file.
# setup preserves the LLM and image settings below while updating service tokens.

# Agent LLM: use an explicit LiteLLM provider/model identifier.
LLM_MODEL=openai/gpt-5.4
# LLM_API_KEY takes precedence over OPENAI_API_KEY from the process environment.
LLM_API_KEY=
# Empty, none, direct, or - uses the provider's default endpoint.
# For a gateway, set your own OpenAI-compatible URL (typically ending in /v1).
LLM_BASE_URL=
# Only used for azure/ models; select a version supported by your deployment.
LLM_API_VERSION=2025-03-01-preview

# Privacy auditor: set the model and endpoint for your own deployment.
# Leaving MODEL empty retains the legacy model in Config; it may be unavailable
# at your provider. Configure these explicitly before running audit variants.
EXTRACTION_LLM_MODEL=
EXTRACTION_LLM_BASE_URL=
# Empty reuses the agent API key. Set this for a different provider/account.
EXTRACTION_LLM_API_KEY=

# Build this image from the checked-out SDK source before running agents.
AGENT_SERVER_IMAGE=agentprivarena-agent-server:local
DOCKER_NETWORK=agentprivarena_agentprivarena-net

# BookStack tokens must be created for your local instance before setup succeeds.
BOOKSTACK_URL=http://localhost:3000
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Generated by setup after GoToSocial provisioning; leave empty initially.
GOTOSOCIAL_TOKEN=

# Relative to the repository root for host-side commands.
GOOGLE_DRIVE_ARTIFACT_ROOT=.agent_tmp/agentprivarena_artifacts/google_drive
